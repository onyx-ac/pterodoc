{
  "name": "pterodocs-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace root for pterodocs. The published packages live in packages/.",
  "workspaces": [
    "packages/*",
    "packages/wordpress/plugin"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:types": "tsc -b --force ./tsconfig.json",
    "build:js": "rollup --config ./rollup.config.mjs",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "prepare": "npm run build",
    "typecheck": "tsc -p ./tsconfig.dev.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/tests.mjs unit",
    "test:integration": "node scripts/tests.mjs integration",
    "fixtures": "tsx scripts/write-fixtures.ts",
    "release": "npm run build && npm publish --workspaces"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^20.19.0",
    "rollup": "^4.53.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-ac/pterodocs.git"
  },
  "bugs": {
    "url": "https://github.com/onyx-ac/pterodocs/issues"
  },
  "homepage": "https://github.com/onyx-ac/pterodocs#readme",
  "author": "Onyx <hello@onyx.ac> (https://onyx.ac)",
  "license": "CC-BY-SA-4.0",
  "version": "0.5.0"
}
