{
  "name": "@pterodocs/wordpress",
  "version": "0.5.0",
  "description": "The WordPress REST target for pterodocs.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENCE.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -b --force && rollup -c",
    "test": "node ../../scripts/tests.mjs unit"
  },
  "dependencies": {
    "@pterodocs/core": "0.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-ac/pterodocs.git"
  },
  "homepage": "https://onyx.ac/products/pterodocs/docs/",
  "license": "CC-BY-SA-4.0",
  "publishConfig": {
    "access": "public"
  }
}
